# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# Check 4 (stt_llm) scam-script scoring.
#
# Set this and GroqScriptScorer becomes the primary scorer at startup, with the
# local KeywordScriptScorer behind it as the fallback. Leave it empty and check 4
# still runs, on the keyword scorer alone, which matches fixed patterns and
# misses paraphrase.
#
# NOTE: with this set, transcript text is sent to Groq. That is a deliberate
# prototype decision (2026-09-09) against the local-inference rule in AGENTS.md,
# and it must not be described as local inference anywhere it is claimed.
GROQ_API_KEY=

# Optional. The Groq model check 4 asks for a script judgement. Defaults to
# openai/gpt-oss-120b when unset.
#
# Verified against this account 2026-09-09, scoring a scam script then ordinary
# speech:
#   openai/gpt-oss-120b   0.95 / 0.0   ~0.8s   default
#   qwen/qwen3.8-27b      0.95 / 0.0   ~0.35s  faster, same answers
#   openai/gpt-oss-20b    returns empty content on some inputs, do not use
# GROQ_MODEL=openai/gpt-oss-120b
